/.idea/
/.vscode/

# Local runtime configuration may contain provider credentials.
/.env

# macOS filesystem metadata - never version these.
**/.DS_Store

/dist/
*.log
**/.codeatlas/
/backend/codeatlas

# Eval harness local report artifacts (baseline.json + cases.json are versioned)
eval/report.json
eval/report.md

# E2E harness local reports are regenerated by `make e2e`.
/e2e/reports/*.json
/e2e/reports/*.md
/e2e/.generated/

# Stray binaries left by `go build ./cmd/<x>` in backend/ (use make build -> dist/)
/backend/eval
/backend/treesitter-tool

# Editor spike generated assets; compact benchmark results remain versioned.
/frontend/spikes/dist/
/frontend/spikes/node_modules/
/frontend/spikes/fixtures/generated/

# Production frontend build/dependencies are generated from package-lock.json.
/frontend/node_modules/
/e2e/node_modules/
/frontend/.test-dist/
/backend/internal/webui/dist/
/docs
/examples/codemap-template-reference
VISION.md
