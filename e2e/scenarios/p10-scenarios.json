{
  "scenarioMatrixVersion": "p10-v1",
  "policy": {
    "network": "loopback-only",
    "provider": "e2e/harness/fake-provider.mjs",
    "workspace": "temporary copy of generated or repository fixtures",
    "determinism": "seeded fixtures, monotonic timings, no fixed long sleeps",
    "retry": "no retry in the blocking gate"
  },
  "behavioralRegressions": [
    {
      "id": "provider-schema-compatibility",
      "testFile": "e2e/tests/provider-reindex.test.mjs",
      "coverage": ["structured readiness probe", "vLLM unsupported-key rejection", "real Hover response", "separate embeddings API key"]
    },
    {
      "id": "index-maintenance-contract",
      "testFile": "e2e/tests/provider-reindex.test.mjs",
      "coverage": ["explicit no-op", "changed-file commit", "embedding regeneration", "FTS rebuild"]
    }
  ],
  "groups": [
    {
      "id": "readiness",
      "number": 1,
      "automated": true,
      "commands": ["make e2e", "cd backend && go test -tags fts5 ./internal/app ./internal/httpapi"],
      "coverage": ["happy startup", "provider unavailable", "invalid embeddings", "index failure", "diagnostic-only UI"]
    },
    {
      "id": "document-basic",
      "number": 2,
      "automated": true,
      "commands": ["make e2e", "cd backend && go test -tags fts5 ./internal/httpapi -run Document"],
      "coverage": ["production Monaco for Go/JS/JSX/TS/TSX and module variants", "rapid edit", "save", "self-write confirmation", "atomic clean/dirty reload reclaim", "close/reopen", "10 tabs", "1.5 MiB model"]
    },
    {
      "id": "out-of-order",
      "number": 3,
