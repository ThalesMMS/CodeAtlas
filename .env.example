# Workspace and HTTP server
CODEATLAS_WORKSPACE=./examples/tinycommerce
CODEATLAS_LISTEN=127.0.0.1:8080
CODEATLAS_MAX_FILE_BYTES=1500000

# Required OpenAI-compatible chat provider.
CODEATLAS_LLM_BASE_URL=http://127.0.0.1:8000/v1
CODEATLAS_LLM_API_KEY=replace-me
CODEATLAS_LLM_MODEL=default
# Optional for See More, Codemap, and DeepWiki: none|minimal|low|medium|high|xhigh|max.
# Hover always sends reasoning_effort=none. Omit this setting for legacy providers.
# CodeAtlas adds the gateway's default hidden-reasoning reserve to each final
# output budget; see README.md when REASONING_EFFORT_BUDGETS is customized.
CODEATLAS_LLM_REASONING_EFFORT=medium
# Business request timeout (Go duration). Increase for slow local models.
CODEATLAS_LLM_TIMEOUT=10m

# Optional local Go semantic evidence. auto starts gopls only when Go files exist;
# missing/crashed gopls is reported and Hover falls back to indexed AST evidence.
CODEATLAS_GOPLS=auto
CODEATLAS_GOPLS_PATH=gopls

# Optional local JS/TS semantic evidence. The SDK path, when set, is the
# directory containing tsserver.js (usually TypeScript's lib directory).
CODEATLAS_TYPESCRIPT_LSP=auto
CODEATLAS_TYPESCRIPT_LSP_PATH=typescript-language-server
CODEATLAS_TYPESCRIPT_SDK_PATH=

# Optional local Swift semantic evidence. SourceKit-LSP is never installed and
# CodeAtlas never runs SwiftPM/Xcode builds or workspace commands.
CODEATLAS_SWIFT_LSP=auto
CODEATLAS_SWIFT_LSP_PATH=sourcekit-lsp

# Optional Python semantic evidence. The executable is selected explicitly;
# CodeAtlas never discovers/activates environments or imports user modules.
CODEATLAS_PYTHON_LSP=auto
CODEATLAS_PYTHON_LSP_PATH=pyright-langserver
CODEATLAS_RUST_LSP=auto
CODEATLAS_RUST_LSP_PATH=rust-analyzer

# Optional dense retrieval. When enabled, embedding failures are surfaced as errors.
CODEATLAS_ENABLE_EMBEDDINGS=false
CODEATLAS_EMBEDDING_MODEL=
# Optional: separate embeddings endpoint (defaults to CODEATLAS_LLM_BASE_URL).
CODEATLAS_EMBEDDING_BASE_URL=
# Optional: separate credential (defaults to CODEATLAS_LLM_API_KEY when unset).
CODEATLAS_EMBEDDINGS_API_KEY=replace-me
