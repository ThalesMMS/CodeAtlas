    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.2",
    "axe-core": "4.12.1",
    "monaco-editor": "0.56.0",
    "playwright": "1.61.1",
    "vite": "8.1.0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
